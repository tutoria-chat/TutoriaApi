commands:
  01_backup_nginx:
    command: "mkdir -p /tmp/nginx_backup && cp -r /var/proxy/staging/nginx /tmp/nginx_backup/ 2>/dev/null || true"
    ignoreErrors: true

files:
  "/tmp/nginx_client_max_body_size.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Increase client max body size to 15MB for file uploads
      client_max_body_size 15M;

      # Timeouts
      client_body_timeout 300;
      client_header_timeout 300;
      proxy_connect_timeout 300;
      proxy_send_timeout 300;
      proxy_read_timeout 300;
      send_timeout 300;

      # Disable buffering
      proxy_buffering off;
      proxy_request_buffering off;

container_commands:
  01_inject_nginx_config:
    command: |
      # Inject into staging directory before EB copies it
      mkdir -p /var/proxy/staging/nginx/conf.d
      cp /tmp/nginx_client_max_body_size.conf /var/proxy/staging/nginx/conf.d/00_file_upload_size.conf
      echo "Injected nginx config into staging directory"
    ignoreErrors: false
  02_reload_nginx_after_start:
    command: |
      # Also copy to final location and reload after nginx starts
      sleep 5
      mkdir -p /etc/nginx/conf.d
      cp /tmp/nginx_client_max_body_size.conf /etc/nginx/conf.d/00_file_upload_size.conf
      systemctl reload nginx || service nginx reload
      echo "Reloaded nginx with new config"
    ignoreErrors: true
