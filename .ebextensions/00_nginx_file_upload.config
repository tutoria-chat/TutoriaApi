files:
  "/etc/nginx/conf.d/00_file_upload_size.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Increase client max body size to 15MB for file uploads
      # This prevents "client intended to send too large body" errors
      client_max_body_size 15M;

      # Increase timeouts for large file uploads
      client_body_timeout 300;
      client_header_timeout 300;

      # Proxy settings for large uploads
      proxy_connect_timeout 300;
      proxy_send_timeout 300;
      proxy_read_timeout 300;
      send_timeout 300;

      # Disable proxy buffering to stream uploads directly
      proxy_buffering off;
      proxy_request_buffering off;

container_commands:
  01_reload_nginx:
    command: "sudo systemctl reload nginx || sudo service nginx reload"
